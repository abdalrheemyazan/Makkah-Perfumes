# ==========================================================================
# MAKKAH PERFUMES — משתני סביבה
# העתיקו לקובץ .env ומלאו ערכים אמיתיים. אין להעלות .env ל-git.
# ==========================================================================

# --- בסיס נתונים ----------------------------------------------------------
# פיתוח מקומי: הפעילו `npm run db:server` (PostgreSQL מוטמע, ללא Docker).
# ייצור: הפנו למסד PostgreSQL מנוהל.
DATABASE_URL="postgresql://makkah:makkah_dev_password@localhost:55432/makkah_perfumes?schema=public"

# --- מסד נתונים לבדיקות E2E (מבודד לחלוטין מהפיתוח) ------------------------
# בדיקות Playwright חייבות למסד נפרד ששמו מכיל "test". הריצו `npm run db:test-setup`
# פעם אחת ליצירתו. הבדיקות ייעצרו אם משתנה זה חסר / זהה ל-DATABASE_URL / ללא "test".
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/makkah_perfumes_test?schema=public"

# --- אבטחת סשנים ----------------------------------------------------------
# אין צורך במשתנה סוד. אימות הסשנים משתמש באסימון אקראי (randomBytes) הנשמר
# בעוגייה httpOnly, ובמסד הנתונים נשמר רק ה-hash (SHA-256) שלו. אין AUTH_SECRET.

# --- כתובת האתר -----------------------------------------------------------
# משמש ל-canonical URLs, sitemap, Open Graph וקישורים באימיילים.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- סליקת אשראי ----------------------------------------------------------
# "development" = מצב פיתוח מסומן בבירור בממשק. יוצר הזמנה אמיתית בבסיס הנתונים
#                 אך אינו מבצע חיוב ואינו מציג טופס כרטיס אשראי.
# בייצור החליפו לספק אמיתי (tranzila | cardcom | payplus | stripe) והוסיפו מפתחות.
# ראו docs/DEPLOYMENT.md.
PAYMENT_PROVIDER="development"
# PAYMENT_API_KEY=""
# PAYMENT_TERMINAL_ID=""
# PAYMENT_WEBHOOK_SECRET=""

# --- דואר טרנזקציוני ------------------------------------------------------
# "console" = הדפסת האימייל ללוג השרת במקום שליחה. ברירת מחדל לפיתוח.
MAIL_TRANSPORT="console"
MAIL_FROM="no-reply@example.com"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# יעד להתראת מנהל על פנייה חדשה מטופס יצירת הקשר. ריק = לא נשלחת התראה
# (הפנייה נשמרת ומוצגת בלוח הניהול בכל מקרה). נשלח רק כשמוגדר ספק דואר אמיתי.
CONTACT_NOTIFICATION_EMAIL=""

# --- הרשאות מנהל ראשוני ---------------------------------------------------
# משמש רק על ידי `npm run db:seed` ליצירת חשבון הניהול הראשון.
SEED_ADMIN_EMAIL="admin@makkah.local"
SEED_ADMIN_PASSWORD="Admin123!makkah"

# --- יצירת/איפוס מנהל־על ידני (SUPER_ADMIN) --------------------------------
# אין להגדיר כאן סיסמה אמיתית. הריצו פעם אחת עם משתני סביבה מקומיים בלבד:
#   ADMIN_SEED_EMAIL="you@example.com" ADMIN_SEED_PASSWORD="…" npm run admin:create
# הפקודה אידמפוטנטית: אם המשתמש קיים היא מאפסת את הסיסמה ומוודאת הרשאת SUPER_ADMIN,
# בלי ליצור כפילות. לרוטציית סיסמה — הריצו שוב עם ADMIN_SEED_PASSWORD חדש.
# הסיסמה עוברת hash (bcrypt) לפני שמירה ואינה נכתבת ללוגים או ל-git.

# --- הגבלת קצב ------------------------------------------------------------
# "memory" מתאים לשרת יחיד בפיתוח. בייצור מרובה-אינסטנסים השתמשו ב-redis.
RATE_LIMIT_DRIVER="memory"
# REDIS_URL=""

# --- התראות Web Push (עדכון חזרה למלאי) -----------------------------------
# צרו זוג מפתחות VAPID פעם אחת:  npx web-push generate-vapid-keys
# המפתח הציבורי (NEXT_PUBLIC_) נחשף לדפדפן — זה תקין ומתוכנן.
# המפתח הפרטי הוא סוד: לעולם אין להעלותו ל-git ואין לחשוף אותו לדפדפן.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# כתובת קשר לספקי ה-push. כתובת mailto: או ה-URL של האתר.
VAPID_SUBJECT="mailto:no-reply@example.com"

# --- ג'וב עיבוד התראות (fallback/retry) -----------------------------------
# סוד משותף המגן על POST /api/restock/process. ריק = הנקודה מושבתת לחלוטין.
# צרו ערך אקראי:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESTOCK_JOB_SECRET=""

# --- ניקוי חשבונות וקופון השקה --------------------------------------------
ADMIN_KEEP_EMAIL="yazanabdalrheem@gmail.com"
# ADMIN_KEEP_PASSWORD=""
# ALLOW_PRODUCTION_ACCOUNT_CLEANUP="false"
# LAUNCH_COUPON_CODE="LAUNCH10"
# LAUNCH_COUPON_TYPE="PERCENTAGE"
# LAUNCH_COUPON_VALUE="10"
# LAUNCH_COUPON_MIN_SUBTOTAL=""
# LAUNCH_COUPON_MAX_USES=""
# LAUNCH_COUPON_EXPIRES_AT=""

