# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local embedded postgres cluster (development only)
/.postgres-data

# database logical backups (may contain customer data)
/backups

# playwright
/test-results
/playwright-report
/.playwright

# netlify local cache / CLI
.netlify

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# higgsfield raw generation candidates (temporary inputs, not shipped)
/.cache
